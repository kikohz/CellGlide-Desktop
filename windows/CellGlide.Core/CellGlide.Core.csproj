<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>CellGlide.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- The native tests check the DLL's return codes against NativeMethods' constants. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CellGlide.Tests" />
  </ItemGroup>

  <!-- The Rust side: built by `cargo build -p cg-ffi`, copied next to whatever references this project.
       Always, not PreserveNewest: switching between the debug and release DLL must not keep the newer one. -->
  <ItemGroup>
    <None Include="$(CellGlideNativeDll)" Link="cellglide_native.dll" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" Visible="false" />
  </ItemGroup>

  <!-- A Release build takes target\release's DLL, so it says to build that one. -->
  <Target Name="CheckCellGlideNative" BeforeTargets="BeforeBuild" Condition="!Exists('$(CellGlideNativeDll)')">
    <Error Condition="'$(Configuration)' == 'Release'" Text="$(CellGlideNativeDll) is missing: run 'cargo build -p cg-ffi --release' first (or pass -p:CellGlideNativeDir=...)." />
    <Error Condition="'$(Configuration)' != 'Release'" Text="$(CellGlideNativeDll) is missing: run 'cargo build -p cg-ffi' first (or pass -p:CellGlideNativeDir=...)." />
  </Target>

  <!-- A Release build or publish ships the release DLL. The debug one is unoptimised, may be the
       `testing` build that cargo test leaves there, and honours CELLGLIDE_DIAG_TARGET (diagnostics to any
       local port). Also checked before the copy items are collected, so a publish that skips the build is caught too. -->
  <Target Name="CheckCellGlideNativeRelease"
          BeforeTargets="BeforeBuild;GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems"
          Condition="'$(Configuration)' == 'Release' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(CellGlideNativeDll)', '(?i)[\\/]debug[\\/]cellglide_native\.dll$'))">
    <Error Text="A Release build must not ship the debug DLL $(CellGlideNativeDll): run 'cargo build -p cg-ffi --release' and leave CellGlideNativeDir unset (Release defaults to target\release\), or pass -p:CellGlideNativeDir=..\target\release\." />
  </Target>

</Project>
