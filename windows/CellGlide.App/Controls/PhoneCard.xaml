<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CellGlide.App.Controls.PhoneCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:CellGlide.App.Controls">
    <StackPanel Spacing="8">
        <!-- Carrier, radio; model and battery on the right. -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Grid x:Name="RadioTag" Grid.Column="1" VerticalAlignment="Center">
                <Rectangle RadiusX="9" RadiusY="9" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15" />
                <TextBlock x:Name="RadioText" Margin="6,1,6,1" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Grid>
            <TextBlock x:Name="ModelText" Grid.Column="3" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="BatteryText" Grid.Column="4" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <TextBlock x:Name="NotSharingText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Download and upload, then the last minute's trail on the right. -->
        <Grid x:Name="SpeedRow" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DownText" VerticalAlignment="Center" />
            <TextBlock x:Name="UpText" Grid.Column="1" VerticalAlignment="Center" />
            <c:TrailChart x:Name="Trail" Grid.Column="3" VerticalAlignment="Center" />
        </Grid>

        <Rectangle x:Name="QualityRule" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <TextBlock x:Name="QualityText" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Rectangle x:Name="BatteryRule" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <TextBlock x:Name="BatteryLineText" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="HeatText" FontSize="13" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
