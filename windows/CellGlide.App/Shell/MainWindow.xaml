<?xml version="1.0" encoding="utf-8"?>
<!-- The main window, after cg-gui's app.rs view: the sidebar (the DLL's groups, titles and dots),
     the version under it, and the selected page. The title bar is drawn here so Mica runs under it. -->
<Window
    x:Class="CellGlide.App.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar: the app's icon and the DLL's window title. -->
        <Grid x:Name="AppTitleBar" Height="48" ColumnSpacing="12" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="16" Height="16" VerticalAlignment="Center" Source="ms-appx:///Assets/AppIcon-128.png"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left" OpenPaneLength="200"
                        IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnSelectionChanged">
            <NavigationView.Resources>
                <!-- A group's heading (the DLL's text): caption size, semibold, secondary colour, so it reads
                     as a heading over its items rather than as another item. Explicit setters (CaptionTextBlockStyle's
                     size and line height), not BasedOn: a deferred system style can be missing after a theme switch. -->
                <Style x:Key="SidebarHeading" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="LineHeight" Value="16" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
                <!-- The header itself: the stock template draws its text in the items' own size and colour.
                     The pane never collapses here (no toggle button), so the template needs no pane states. -->
                <Style x:Key="SidebarHeader" TargetType="NavigationViewItemHeader">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="AutomationProperties.AccessibilityView" Value="Content" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="NavigationViewItemHeader">
                                <TextBlock Margin="16,16,12,4" Text="{TemplateBinding Content}" TextWrapping="Wrap"
                                           Style="{StaticResource SidebarHeading}" AutomationProperties.AccessibilityView="Raw" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </NavigationView.Resources>
            <NavigationView.PaneFooter>
                <!-- The version, as the tray menu's first entry says it. -->
                <TextBlock x:Name="VersionText" Margin="16,8,16,12" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </NavigationView.PaneFooter>
        </NavigationView>
    </Grid>
</Window>
