<?xml version="1.0" encoding="utf-8"?>
<!-- The DNS leak test, after cg-gui's pages/leak.rs: what it does, Start, then the verdict, the checks
     when DNS isn't managed, your exit and the DNS servers grouped by owner, and DB-IP's credit. Every
     text is the DLL's; the code fills the parts that follow the view. -->
<Page
    x:Class="CellGlide.App.Pages.LeakPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:CellGlide.App.Controls"
    xmlns:h="using:CellGlide.App.Hosting">
    <Page.Resources>
        <!-- cg-gui's kit::card: 14 padding, 10 corners, a hairline edge. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20,24,20">
            <StackPanel MaxWidth="620" Spacing="14">
                <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" Text="{x:Bind h:L.T('nav.dns_leak')}" />
                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind h:L.T('leak.about')}" />

                <!-- Start (off while a test runs, with "Testing…" beside it). -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Padding="14,5,14,6" IsEnabled="False" Click="OnStartClick" />
                    <TextBlock x:Name="RunningLine" Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                               Text="{x:Bind h:L.T('leak.running')}" />
                </Grid>

                <!-- Why the last run gave nothing, or a command that failed. -->
                <TextBlock x:Name="ErrorLine" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite" />

                <StackPanel x:Name="ResultBlock" Spacing="14" Visibility="Collapsed">
                    <!-- The verdict, on its tone's tint. -->
                    <Border x:Name="VerdictCard" Padding="14" CornerRadius="10">
                        <StackPanel Spacing="3">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="ToneDot" Width="10" Height="10" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="VerdictTitle" Grid.Column="1" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                            <TextBlock x:Name="VerdictDetail" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- The checks, when DNS isn't managed by CellGlide. -->
                    <c:ChecksList x:Name="DoctorChecks" Visibility="Collapsed" />

                    <!-- Your exit, then the DNS servers grouped by owner. -->
                    <!-- The exit has no LabeledBy: UIA would then take "Your exit" as its name and the exit itself would not be read. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind h:L.T('leak.you')}" />
                                <TextBlock x:Name="You" Grid.Column="1" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Grid>
                            <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind h:L.T('leak.resolvers')}" />
                            <TextBlock x:Name="NoneSeen" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                                       Text="{x:Bind h:L.T('leak.none_seen')}" />
                            <StackPanel x:Name="Groups" Spacing="8" />
                            <TextBlock x:Name="ManyIps" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                                       Text="{x:Bind h:L.T('leak.many_ips')}" />
                            <TextBlock x:Name="Subnet" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <HyperlinkButton Padding="0" FontSize="12" NavigateUri="https://db-ip.com" Content="{x:Bind h:L.T('leak.attribution')}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
