<?xml version="1.0" encoding="utf-8"?>
<!-- Diagnostics, after cg-gui's pages/diagnostics.rs: what is sent, the range, an optional email and note,
     then look at exactly what would be sent, send it, or save it (to Downloads, or anywhere with Save As).
     Every text is the DLL's; the code fills the parts that follow the view model. -->
<Page
    x:Class="CellGlide.App.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:CellGlide.App.Hosting">
    <Page.Resources>
        <!-- cg-gui's kit::card: 14 padding, 10 corners, a hairline edge. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Rule" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20,24,20">
            <StackPanel MaxWidth="620" Spacing="14">
                <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" Text="{x:Bind h:L.T('nav.diagnostics')}" />

                <!-- The report just sent, in place of the form (cg-gui sent_card): its code to copy and pass on,
                     then Send Another (keeps the email and note) or Done (clears them). -->
                <Border x:Name="SentCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Spacing="10" HorizontalAlignment="Center" Padding="0,14,0,14">
                        <Ellipse x:Name="SentDot" Width="28" Height="28" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="SentTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Text="{x:Bind h:L.T('diag.sent_title')}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Border Padding="10,4,10,4" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <!-- Said when it appears: the send's result. -->
                                <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="15" IsTextSelectionEnabled="True"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Border>
                            <!-- Named by its own text ("Copy" / "Copied"), said again when it changes. -->
                            <Button x:Name="CopyCodeButton" FontSize="12" VerticalAlignment="Center" Click="OnCopyCodeClick"
                                    AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <TextBlock FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind h:L.T('diag.code_hint')}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button x:Name="AgainButton" FontSize="12" Click="OnAgainClick" Content="{x:Bind h:L.T('diag.again')}" />
                            <Button x:Name="DoneButton" FontSize="12" Style="{ThemeResource AccentButtonStyle}" Click="OnDoneClick"
                                    Content="{x:Bind h:L.T('common.done')}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="FormCard" Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"
                                   Text="{x:Bind h:L.T('diag.send_title')}" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind h:L.T('diag.about_gui')}" />
                        <Rectangle Style="{StaticResource Rule}" />

                        <!-- The range: one group named by its label (the group's header), each choice by its own text. -->
                        <RadioButtons x:Name="Range" MaxColumns="2" SelectedIndex="0" SelectionChanged="OnRangeChanged"
                                      AutomationProperties.Name="{x:Bind h:L.T('diag.range')}">
                            <RadioButtons.Header>
                                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind h:L.T('diag.range')}" />
                            </RadioButtons.Header>
                            <RadioButton Content="{x:Bind h:L.T('diag.range_day')}" />
                            <RadioButton Content="{x:Bind h:L.T('diag.range_week')}" />
                        </RadioButtons>
                        <Rectangle Style="{StaticResource Rule}" />

                        <!-- Email and note, both optional. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EmailLabel" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind h:L.T('diag.email')}" />
                            <TextBox x:Name="Email" Grid.Column="1" FontSize="13" InputScope="EmailSmtpAddress" TextChanged="OnFieldChanged"
                                     AutomationProperties.LabeledBy="{x:Bind EmailLabel}" PlaceholderText="{x:Bind h:L.T('common.optional')}" />
                        </Grid>
                        <Rectangle Style="{StaticResource Rule}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NoteLabel" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind h:L.T('diag.note')}" />
                            <TextBox x:Name="Note" Grid.Column="1" FontSize="13" Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="OnFieldChanged"
                                     AutomationProperties.LabeledBy="{x:Bind NoteLabel}" PlaceholderText="{x:Bind h:L.T('common.optional')}" />
                        </Grid>
                        <Rectangle Style="{StaticResource Rule}" />

                        <!-- What is going on or went wrong, then the buttons. -->
                        <TextBlock x:Name="ErrorLine" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="BusyLine" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="SaveButton" FontSize="12" Click="OnSaveClick" Content="{x:Bind h:L.T('diag.save')}" />
                            <Button x:Name="SaveAsButton" FontSize="12" Click="OnSaveAsClick" Content="{x:Bind h:L.T('diag.save_as')}" />
                            <Button x:Name="ViewButton" FontSize="12" Click="OnViewClick" Content="{x:Bind h:L.T('diag.view')}" />
                            <Button x:Name="SendButton" FontSize="12" Style="{ThemeResource AccentButtonStyle}" Click="OnSendClick"
                                    Content="{x:Bind h:L.T('diag.send')}" />
                        </StackPanel>
                        <TextBlock x:Name="NeedsPreview" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind h:L.T('diag.send_needs_preview')}" />

                        <!-- Where the bundle was saved, and Show in Folder. -->
                        <Grid x:Name="SavedRow" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SavedLine" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="OpenFolderButton" Grid.Column="1" FontSize="12" Click="OnOpenFolderClick" Content="{x:Bind h:L.T('diag.open_folder')}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Exactly what Send would send. -->
                <Border x:Name="PreviewCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="PreviewTitle" FontSize="15" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"
                                   Text="{x:Bind h:L.T('diag.preview_title')}" />
                        <TextBox x:Name="Preview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 Height="360" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.LabeledBy="{x:Bind PreviewTitle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
