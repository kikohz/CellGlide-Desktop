<?xml version="1.0" encoding="utf-8"?>
<!-- A stand-in with the page's title only; Task 8 fills it. The frame is cg-gui's kit::page. -->
<Page
    x:Class="CellGlide.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:CellGlide.App.Hosting">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20,24,20">
            <StackPanel MaxWidth="620" Spacing="18">
                <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Bind h:L.T('nav.history')}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
