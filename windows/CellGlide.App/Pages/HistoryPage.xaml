<?xml version="1.0" encoding="utf-8"?>
<!-- Connection history, after cg-gui's pages/history.rs: the day with previous / next, the legend, the
     24-hour strip with its hours, then the day's events, newest first; an event with readings expands.
     Every text is the DLL's; the code fills the parts that follow the view. -->
<Page
    x:Class="CellGlide.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:CellGlide.App.Controls"
    xmlns:h="using:CellGlide.App.Hosting">
    <Page.Resources>
        <!-- cg-gui's kit::card, here without padding: the rows bring their own. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20,24,20">
            <StackPanel MaxWidth="620" Spacing="14">
                <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" Text="{x:Bind h:L.T('nav.history')}" />

                <!-- Previous, next, the day; the legend on the right. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PrevButton" Padding="8,4,8,4" IsEnabled="False" Click="OnPrevClick"
                            AutomationProperties.Name="{x:Bind h:L.T('common.prev')}" ToolTipService.ToolTip="{x:Bind h:L.T('common.prev')}">
                        <FontIcon FontSize="12" Glyph="&#xE76B;" />
                    </Button>
                    <Button x:Name="NextButton" Grid.Column="1" Padding="8,4,8,4" IsEnabled="False" Click="OnNextClick"
                            AutomationProperties.Name="{x:Bind h:L.T('common.next')}" ToolTipService.ToolTip="{x:Bind h:L.T('common.next')}">
                        <FontIcon FontSize="12" Glyph="&#xE76C;" />
                    </Button>
                    <TextBlock x:Name="DayLabel" Grid.Column="2" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel x:Name="Legend" Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" />
                </Grid>

                <!-- Why the day couldn't be loaded, and Try again. -->
                <Grid x:Name="ErrorRow" ColumnSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ErrorLine" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="RetryButton" Grid.Column="1" FontSize="12" Click="OnRetryClick" Content="{x:Bind h:L.T('history.retry')}" />
                </Grid>

                <StackPanel x:Name="DayBlock" Spacing="14" Visibility="Collapsed">
                    <c:DayStrip x:Name="Strip" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel x:Name="Rows" />
                            <TextBlock x:Name="Empty" FontSize="13" Margin="28" HorizontalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                                       Text="{x:Bind h:L.T('history.empty')}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
