<?xml version="1.0" encoding="utf-8"?>
<!-- The open source licenses (the DLL's text), a paragraph per row so the long list is virtualized;
     monospace, selectable, closed with common.close. -->
<ContentDialog
    x:Class="CellGlide.App.Pages.LicensesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:CellGlide.App.Hosting"
    Title="{x:Bind h:L.T('about.licenses')}"
    CloseButtonText="{x:Bind h:L.T('common.close')}"
    DefaultButton="Close"
    AutomationProperties.Name="{x:Bind h:L.T('about.licenses')}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
    </ContentDialog.Resources>
    <!-- Width: up to 700, narrower with the window (set in code), so the dialog never clips. -->
    <ListView x:Name="List" Height="440" SelectionMode="None" IsItemClickEnabled="False"
              AutomationProperties.Name="{x:Bind h:L.T('about.licenses')}">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="x:String">
                <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,6,0,6" />
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</ContentDialog>
