<?xml version="1.0" encoding="utf-8"?>
<!-- The speed test, after cg-gui's pages/speed.rs: what it measures, "also test Wi-Fi", Start or Cancel
     with the sentence beside it, one column per route (numbers, curve, progress, stage), the comparison,
     and the recent results. Every text is the DLL's; the code fills the parts that follow the view. -->
<Page
    x:Class="CellGlide.App.Pages.SpeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:CellGlide.App.Hosting">
    <Page.Resources>
        <!-- cg-gui's kit::card: 14 padding, 10 corners, a hairline edge. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20,24,20">
            <StackPanel MaxWidth="620" Spacing="18">
                <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Bind h:L.T('nav.speed_test')}" />
                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind h:L.T('speed.page_about')}" />

                <!-- Also test Wi-Fi (only when the DLL offers it), Start or Cancel, the sentence beside it. -->
                <StackPanel Spacing="12">
                    <CheckBox x:Name="IncludeWifi" Visibility="Collapsed" Click="OnIncludeWifiClick" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartButton" Padding="12,5,12,6" IsEnabled="False" Click="OnStartClick" />
                        <TextBlock x:Name="StartNote" Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="ErrorLine" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <!-- The routes side by side, then the comparison. -->
                <Border x:Name="ResultsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <Grid x:Name="Legs" ColumnSpacing="16" />
                        <StackPanel x:Name="VerdictBlock" Spacing="10" Visibility="Collapsed">
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock x:Name="Verdict" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The recent results. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RecentTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{x:Bind h:L.T('speed.recent')}" />
                            <Button x:Name="ClearButton" Grid.Column="1" Padding="8,2,8,3" Visibility="Collapsed"
                                    Background="Transparent" BorderThickness="0"
                                    Content="{x:Bind h:L.T('common.clear')}" Click="OnClearClick" />
                        </Grid>
                        <TextBlock x:Name="HistoryFailed" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind h:L.T('speed.history_failed')}" />
                        <TextBlock x:Name="HistoryEmpty" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind h:L.T('speed.history_empty')}" />
                        <Grid x:Name="History" ColumnSpacing="16" RowSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
