<Project>
  <!-- Settings shared by every project under windows/. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Both Windows architectures are restored every time, so the lock files record both and a
         `-r win-arm64` build or publish finds them already there (and leaves them unchanged). -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Where cellglide_native.dll is found: cargo's debug output unless given with -p:CellGlideNativeDir=... -->
    <CellGlideNativeDir Condition="'$(CellGlideNativeDir)' == ''">$(MSBuildThisFileDirectory)..\target\debug\</CellGlideNativeDir>
    <!-- A relative directory is taken from windows\ (this file's directory), whichever project or
         working directory the build starts from; it may also lack its trailing slash. -->
    <CellGlideNativeDll>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$(CellGlideNativeDir)'))))))cellglide_native.dll</CellGlideNativeDll>
  </PropertyGroup>
</Project>
