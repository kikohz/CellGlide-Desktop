<Project>
  <!-- Settings shared by every project under windows/. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Where cellglide_native.dll is found: cargo's debug output unless given with -p:CellGlideNativeDir=... -->
    <CellGlideNativeDir Condition="'$(CellGlideNativeDir)' == ''">$(MSBuildThisFileDirectory)..\target\debug\</CellGlideNativeDir>
    <!-- A directory given on the command line may lack its trailing slash. -->
    <CellGlideNativeDll>$([MSBuild]::EnsureTrailingSlash('$(CellGlideNativeDir)'))cellglide_native.dll</CellGlideNativeDll>
  </PropertyGroup>
</Project>
